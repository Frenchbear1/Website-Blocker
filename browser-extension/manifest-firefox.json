{
  "manifest_version": 2,
  "name": "Website Blocker Browser Companion",
  "version": "0.4.7",
  "description": "Syncs site rules and reports focused website domains locally for Screen Usage and time limits.",
  "icons": {
    "16": "icons/violet-16.png",
    "32": "icons/violet-32.png",
    "48": "icons/violet-48.png",
    "128": "icons/violet-128.png"
  },
  "permissions": ["alarms", "http://127.0.0.1:17843/*"],
  "background": {"scripts": ["background.js"]},
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": ["blocked.html", "blocked.js", "blocked.css"],
  "browser_action": {
    "default_title": "Website Blocker Browser Companion",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/violet-16.png",
      "32": "icons/violet-32.png"
    }
  },
  "applications": {"gecko": {"id": "companion@website-blocker.local", "strict_min_version": "109.0"}}
}
